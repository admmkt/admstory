rules_version = '2';
// Publicar: firebase deploy --only firestore:rules (na pasta AutomatizadorStories).
service cloud.firestore {
  match /databases/{database}/documents {
    // Plano do usuário. Só o dono lê; ninguém grava pelo app/site. Quem grava
    // "paidUntil" é o servidor de pagamentos (worker/), com conta de serviço,
    // depois de conferir a assinatura direto na API do Mercado Pago.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
  }
}
